# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle — keep secrets out of them.

# ---------------------------------------------------------------- contact ----
# International format, digits only (e.g. 2348012345678). No "+" or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PROJECT_EMAIL=

# ------------------------------------------------------------------ links ----
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_DEV_PORTFOLIO_URL=
NEXT_PUBLIC_ENG_PORTFOLIO_URL=

# ----------------------------------------------------------------- intake ----
# accepting | limited | closed
NEXT_PUBLIC_INTAKE_STATUS=accepting
# Free text, e.g. "Week of 15 September". Leave empty to hide the line —
# do not put a date here unless it is real.
NEXT_PUBLIC_NEXT_SLOT=
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# ----------------------------------------------------------------- gemini ----
# Server-side only. Without it the estimator serves a clearly-labelled sample.
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash
# Currency and market the model prices against.
ESTIMATE_CURRENCY=NGN (₦)
ESTIMATE_MARKET=Nigeria

# ------------------------------------------------------------ rate limiting ---
# Signs the estimator session cookie. At least 16 characters; required in
# production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESTIMATE_SECRET=

# Local development only: lifts the one-estimate-per-visitor limit and the burst
# guard so the estimator can be exercised repeatedly. Never read when NODE_ENV is
# production — setting it on a deployment has no effect.
ESTIMATE_UNLIMITED=
